FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src

COPY requirements.ui.txt ./
RUN pip install --no-cache-dir -r requirements.ui.txt

COPY src ./src

EXPOSE 8501
CMD ["streamlit", "run", "src/british_museum_agent/interfaces/streamlit/app.py", "--server.address", "0.0.0.0", "--server.port", "8501"]