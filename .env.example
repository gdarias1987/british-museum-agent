APP_ENV=local
APP_NAME=British Museum Agent
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_BACKEND_URL=http://backend:8000

DATA_DIR=./data
RAW_SPANISH_PATH=./data/raw/spanish
INDEX_PATH=./data/processed/knowledge_index.json
SQLITE_PATH=./data/sqlite/app.db
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION_NAME=british_museum_es
RETRIEVAL_BACKEND=chroma
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RETRIEVAL_CANDIDATE_K=10

LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
GEMINI_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=british-museum-agent

# Phoenix OSS is self-hosted by Compose. Empty endpoint/key values are cloud override mocks;
# Compose resolves the empty endpoint to http://phoenix:4317 and does not require an API key.
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=british-museum-agent
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
OPENINFERENCE_HIDE_INPUTS=true
OPENINFERENCE_HIDE_OUTPUTS=true

STAFF_DEMO_USERNAME=staff@example.com
STAFF_DEMO_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

MCP_SERVER_URL=http://localhost:8001/mcp
MCP_INTERNAL_TOKEN=
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
