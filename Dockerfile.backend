FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src

COPY requirements.txt ./
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.13.0+cpu \
    && pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY scripts ./scripts
COPY data/raw ./data/raw
RUN mkdir -p ./data/processed ./data/chroma ./data/sqlite

EXPOSE 8000
CMD ["sh", "-c", "python scripts/ingest.py && python scripts/ingest_chroma.py && uvicorn british_museum_agent.api.main:app --host 0.0.0.0 --port 8000"]